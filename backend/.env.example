# Copia este archivo a .env y ajusta valores

PORT=3000

# MySQL — debe coincidir con la base cargada desde PROYECTO SENA/BASE DE DATOS/
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=constructora_gg

# Tras clonar: importa el esquema desde la raíz del repo (usuario con permisos DDL):
#   mysql -u root -p < "PROYECTO SENA/BASE DE DATOS/constructora_gg v1.sql"
#   mysql -u root -p constructora_gg < "PROYECTO SENA/BASE DE DATOS/inserts.sql"
# Luego: npm run seed-passwords -- "contraseña_de_prueba"

# JWT (genera un valor largo y aleatorio; no lo subas a git)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Si ves "Access denied for user 'root'@'localhost'":
# - Pon en DB_PASSWORD la contraseña real de root, o
# - En Ubuntu/Debian a veces root solo entra por socket (sudo mysql). Mejor crea un usuario para la app:
#   CREATE USER 'constructora_app'@'localhost' IDENTIFIED BY 'tu_clave_segura';
#   GRANT ALL PRIVILEGES ON constructora_gg.* TO 'constructora_app'@'localhost';
#   FLUSH PRIVILEGES;
#   Luego DB_USER=constructora_app y DB_PASSWORD=tu_clave_segura
